-- Wave Brush (Always-On Version)
-- Simplified to use local variables (works like Ink Drip brush)

local lastDrawX = 0
local lastDrawY = 0
local firstDraw = true
local currentWidth = 0
local targetWidth = 0
local transitionSteps = 0
local maxTransitionSteps = 25  -- smoother transitions

bs_setmode(1)

function default_size()
  return 4, 0.25
end

function param1()
  return "wave intensity", 1, 10, 7
end

-- Calculate the next target width for the wave effect
local function calculateNextTargetWidth(baseWidth)
  local intensity = bs_param1() / 10
  local minWidth = baseWidth * (1 - intensity * 0.3)
  local maxWidth = baseWidth * (1 + intensity * 0.3)

  local rand = math.random()
  rand = (rand + rand + rand) / 3
  return (maxWidth - minWidth) * rand + minWidth
end

-- Smoothly interpolate between current width and target width
local function updateWidth()
  if transitionSteps >= maxTransitionSteps then
    currentWidth = targetWidth
    targetWidth = calculateNextTargetWidth(bs_width())
    transitionSteps = 0
  else
    local t = transitionSteps / maxTransitionSteps
    t = t * t * t * (t * (t * 6 - 15) + 10)
    currentWidth = currentWidth + (targetWidth - currentWidth) * t
    transitionSteps = transitionSteps + 1
  end
  return currentWidth
end

-- Draw a single stamp with the current width
local function drawStamp(x, y, width)
  local r, g, b = bs_fore()
  local opacity = bs_opaque() * 255
  bs_ellipse(x, y, width, width, 0, r, g, b, opacity)
end

-- Main brush function
function main(x, y, p)
  local baseWidth = bs_width()

  if firstDraw then
    currentWidth = baseWidth
    targetWidth = calculateNextTargetWidth(baseWidth)
    firstDraw = false
  end

  local width = updateWidth()
  drawStamp(x, y, width)

  lastDrawX = x
  lastDrawY = y

  -- Always return 1 so it never stops drawing
  return 1
end

-- Reset when stroke ends
function stroke_end()
  firstDraw = true
  transitionSteps = 0
end
